# Copy to .env — never commit real values.
DATABASE_URL=sqlite:///./foodmania.db        # or postgresql+psycopg://user:pass@localhost:5432/foodmania
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true                               # enables demo clock + simulated checkout; set false in any real deployment
COOKIE_SECURE=false                          # true behind HTTPS
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
# Optional: enables LLM phrasing for open-ended recommendation chat (safety facts stay deterministic)
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
